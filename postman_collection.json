    {
      "name": "2. Items Management Suite",
      "item": [
        {
          "name": "2.1 Get All Active Items Feed",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Items feed returns array with count', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.data).to.be.an('array');",
                  "    pm.expect(json.count).to.be.above(0);",
                  "    var currentUserId = pm.environment.get('currentUserId');",
                  "    var otherItem = json.data.find(function(i) {",
                  "        var rep = i.reportedBy ? (i.reportedBy._id || i.reportedBy) : '';",
                  "        return String(rep) !== String(currentUserId);",
                  "    });",
                  "    if (otherItem) {",
                  "        pm.environment.set('targetClaimItemId', otherItem._id);",
                  "    } else if (json.data.length > 0) {",
                  "        pm.environment.set('targetClaimItemId', json.data[0]._id);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/items",
              "host": ["{{baseUrl}}"],
              "path": ["api", "items"]
            }
          }
        },
        {
          "name": "2.2 Filter Items by Category",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Filter by category returns matching items', function () {",
                  "    pm.response.to.have.status(200);",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    json.data.forEach(function(i) {",
                  "        pm.expect(i.category).to.eql('Electronics & Gadgets');",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/items?category=Electronics & Gadgets",
              "host": ["{{baseUrl}}"],
              "path": ["api", "items"],
              "query": [
                {
                  "key": "category",
                  "value": "Electronics & Gadgets"
                }
              ]
            }
          }
        },
