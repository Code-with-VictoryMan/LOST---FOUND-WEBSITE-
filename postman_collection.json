  "item": [
    {
      "name": "1. Authentication Suite",
      "item": [
        {
          "name": "1.1 Student Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Login returns token and student user object', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.token).to.be.a('string');",
                  "    pm.expect(json.user.role).to.eql('student');",
                  "    pm.environment.set('studentToken', json.token);",
                  "    pm.environment.set('currentUserId', json.user.id);",
                  "});",
                  "pm.test('Response includes persistent login tracking', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.user).to.have.property('lastLogin');",
                  "    pm.expect(json.user).to.have.property('loginCount');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"saisravan@saiuniversity.edu.in\",\n  \"password\": \"StudentPassword123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
